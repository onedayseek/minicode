# 任意 OpenAI 兼容端点。默认 DeepSeek。
MINICODE_BASE_URL=https://api.deepseek.com
MINICODE_MODEL=deepseek-v4-flash
MINICODE_API_KEY=sk-your-key-here

# 模型的上下文窗口。不按模型名去猜 —— 写死的对照表必然在某个模型上过期，
# 而且是自信地错。填你实际用的那个模型的值，启动横幅里会显示当前设置。
# MINICODE_CONTEXT_WINDOW=1000000

# 模型支持的单次回复上限。它不是固定预留；每次请求会根据当前 active context
# 和安全余量动态收紧实际发送给 provider 的 max_tokens。
# MINICODE_MAX_OUTPUT_TOKENS=384000

# 指定命令解释器，不填则自动解析（Windows 上 pwsh → powershell → cmd）。
# MINICODE_SHELL=bash
